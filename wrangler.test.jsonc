{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stale-cache-test",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-01",
	"observability": {
		"enabled": true
	},
	"cache": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "CACHE_KV",
			"id": "stale-cache-cache-kv"
		}
	]
}
